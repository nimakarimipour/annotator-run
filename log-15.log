        if (A == null) {
            throw new IllegalArgumentException("A is null");
        }
        if (B == null) {
            throw new IllegalArgumentException("B is null");
        }
    
        MutableSparseIntSet sparsePartA = A.sparsePart != null ? A.sparsePart : MutableSparseIntSet.makeEmpty();
        MutableSparseIntSet sparsePartB = B.sparsePart != null ? B.sparsePart : MutableSparseIntSet.makeEmpty();
    
        if (A.densePart == null) {
            if (B.densePart == null) {
                return new SemiSparseMutableIntSet(MutableSparseIntSet.diff(sparsePartA, sparsePartB));
            } else {
                MutableSparseIntSet C = MutableSparseIntSet.diff(sparsePartA, sparsePartB);
                for (IntIterator bits = sparsePartA.intIterator(); bits.hasNext(); ) {
                    int bit = bits.next();
                    if (B.densePart.get(bit)) {
                        C.remove(bit);
                    }
                }
                return new SemiSparseMutableIntSet(C);
            }
        } else {
            OffsetBitVector newDensePart = new OffsetBitVector(A.densePart);
            if (B.densePart == null) {
                for (IntIterator bits = sparsePartB.intIterator(); bits.hasNext(); ) {
                    newDensePart.clear(bits.next());
                }
